{
  "name": "flora",
  "productName": "flora",
  "version": "2.3.9",
  "description": "flora - Minecraft account and bot manager",
  "author": {
    "name": "Woofbrush Design LLC",
    "url": "https://woofbrush.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/woofbrush/flora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woofbrush/flora.git"
  },
  "bugs": {
    "url": "https://github.com/woofbrush/flora/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "preflight": "node scripts/preflight.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win --publish never",
    "dist:installer": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "prismarine-auth": "^3.1.1",
    "socks": "^2.8.10",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  }
}
